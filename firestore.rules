rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- LIKES ---
    // Un usuario solo puede leer/escribir sus propios likes
    match /likes/{likeId} {
      allow read, write: if request.auth != null &&
        (likeId.split('_')[0] == request.auth.uid || likeId.split('_')[1] == request.auth.uid);
    }

    // --- MATCHES ---
    // Solo los usuarios involucrados pueden leer el match
    match /matches/{matchId} {
      allow read: if request.auth != null &&
   		 request.auth.uid in resource.data.usersMatched;

      // Crear match: requiere MEMBRESÍA + RECIPROCIDAD de like.
      // SECURITY 2026-05-29 (R129 R5): el rule anterior solo exigía
      // `request.auth.uid in usersMatched`, así que un atacante podía fabricar
      // matches/X con [attackerUid, victimUid], pasar el check de participante en
      // getMatchUsersLocations + todos los CFs match-scoped, y filtrar la
      // ubicación (lat/lng) + perfil de la víctima. Ahora exige: exactamente 2
      // participantes, el creador entre ellos, y que AMBOS se tengan mutuamente
      // en su array `liked` (like recíproco real). Esto replica el check
      // hasUserLikedBack que iOS+Android ya hacen ANTES de crear el match, así que
      // todo match legítimo lo pasa por construcción; el atacante no puede falsificar
      // `liked` de la víctima (solo la víctima escribe su propio `liked`, rules
      // users/{uid}/liked). Super-likes también pueblan `liked` en ambos clientes.
      // El cron checkMutualLikesAndCreateMatch usa Admin SDK → bypassa rules.
      // Trade-off: 2 get() extra por create (≤10 permitidos); .get('liked', [])
      // evita error si el campo falta.
  		allow create: if request.auth != null &&
            request.resource.data.usersMatched is list &&
            request.resource.data.usersMatched.size() == 2 &&
            request.auth.uid in request.resource.data.usersMatched &&
            (request.resource.data.usersMatched[1] in
              get(/databases/$(database)/documents/users/$(request.resource.data.usersMatched[0])).data.get('liked', [])) &&
            (request.resource.data.usersMatched[0] in
              get(/databases/$(database)/documents/users/$(request.resource.data.usersMatched[1])).data.get('liked', []));

      // Permitir actualizar match (para lastMessageTime, etc.)
      // SECURITY: freeze immutable match identity fields (usersMatched,
      // userTypesAtMatch, createdAt). Previously an attacker in the match
      // could flip `userTypesAtMatch[otherUid]` to block the other user
      // from sending the first message, or remove the other uid entirely.
      allow update: if request.auth != null &&
            request.auth.uid in resource.data.usersMatched &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(
              ['usersMatched', 'userTypesAtMatch', 'createdAt']
            ) &&
            // R141: messageCount is the trust signal for the first-message gate
            // (hasExistingMessages → messageCount>0). It was unfrozen, so a SUGAR_BABY
            // could standalone-set it >0 and bypass the role-based first-message rule.
            // Constrain it: only +1 per update (matches the client's FieldValue.increment(1));
            // the unlocking 0→1 transition is allowed ONLY for a SUGAR_DADDY/MOMMY (the only
            // role that may legitimately send — and thus increment past — the first message),
            // mirroring getSenderTypeAtMatch. 1→N is open (conversation already started).
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['messageCount'])
              || (request.resource.data.messageCount == resource.data.get('messageCount', 0) + 1
                  && (resource.data.get('messageCount', 0) > 0
                      || (resource.data.keys().hasAny(['userTypesAtMatch'])
                            ? resource.data.userTypesAtMatch[request.auth.uid] in ['SUGAR_DADDY', 'SUGAR_MOMMY']
                            // R148: snapshot-less → immutable signed-up role (else live userType for
                            // un-backfilled users), mirroring getSenderTypeAtMatch. Closes the
                            // userType-flip bypass on the messageCount 0→1 unlock too.
                            : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userTypeAtSignup', get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userType', '')) in ['SUGAR_DADDY', 'SUGAR_MOMMY']))));

      // No permitir eliminar
      allow delete: if false;

      // Subcolección de MESSAGES dentro de cada match
      match /messages/{messageId} {
        // Los participantes del match pueden leer mensajes
        allow read: if request.auth != null &&
              request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.usersMatched;

        // Helper function: obtener userType ORIGINAL del remitente (en el momento del match)
        function getSenderTypeAtMatch() {
          let matchData = get(/databases/$(database)/documents/matches/$(matchId)).data;
          return matchData.keys().hasAny(['userTypesAtMatch'])
            ? matchData.userTypesAtMatch[request.auth.uid]
            : getCallerSignupRole();
        }
        // R148: for SNAPSHOT-LESS matches (no userTypesAtMatch) the first-message gate must
        // key on the IMMUTABLE signed-up role, not the now-editable live `userType` (R135
        // made userType client-editable) — otherwise a SUGAR_BABY could flip
        // userType→SUGAR_DADDY, send the first message, then flip back, bypassing the
        // role gate. Prefer userTypeAtSignup; fall back to live userType ONLY when it is
        // absent (un-backfilled users) so NO legitimate first-message breaks while the
        // hourlyUserResets backfill propagates userTypeAtSignup to all users.
        function getCallerSignupRole() {
          let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
          return u.get('userTypeAtSignup', u.get('userType', ''));
        }

        // Helper function: verificar si el match tiene messageCount > 0
        function hasExistingMessages() {
          let matchData = get(/databases/$(database)/documents/matches/$(matchId)).data;
          return matchData.keys().hasAny(['messageCount']) && matchData.messageCount > 0;
        }

        // Regla de creación de mensajes — validación reforzada:
        // - senderId == caller (previene suplantación)
        // - timestamp == request.time (previene backdating)
        // - cuerpo del mensaje limitado a 4000 caracteres (anti-abuse)
        // - receiverId != senderId (previene chat consigo mismo)
        allow create: if request.auth != null &&
              request.auth.uid == request.resource.data.senderId &&
              request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.usersMatched &&
              request.resource.data.get('receiverId', '') != request.auth.uid &&
              (!request.resource.data.keys().hasAny(['message']) ||
               request.resource.data.message is string &&
               request.resource.data.message.size() <= 4000) &&
              // VALIDACIÓN PRIMER MENSAJE: Solo usuarios que eran SUGAR_DADDY/MOMMY al hacer match pueden iniciar.
              // R148: removed the inline `live userType` snapshot-less fallback — it duplicated
              // getSenderTypeAtMatch() (which now resolves snapshot-less via the immutable
              // signed-up role) AND read the editable live userType directly, which was the
              // exact bypass (a SUGAR_BABY flips userType→SUGAR_DADDY to pass it).
              (
                hasExistingMessages() ||
                getSenderTypeAtMatch() == 'SUGAR_DADDY' ||
                getSenderTypeAtMatch() == 'SUGAR_MOMMY'
              );

        // Update: el remitente actualiza carga de fotos efímeras; cualquier participante marca viewedBy
        allow update: if request.auth != null &&
              request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.usersMatched &&
              (
                (request.auth.uid == resource.data.senderId &&
                 // R(2026-05-31): + audioUrl/audioDuration so the sender can complete a voice-note
                 // upload (type:"audio") the same way as an ephemeral photo. Purely additive — only
                 // widens what a sender may patch on their OWN message; the photo flow is unchanged.
                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uploadProgress', 'photoUrl', 'isUploading', 'audioUrl', 'audioDuration'])) ||
                (resource.data.get('isEphemeral', false) == true &&
                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy']))
              );

        allow delete: if false;
      }
    }

    // --- USERS ---
    match /users/{userId} {
      // Cualquier usuario autenticado puede leer perfiles
      allow read: if request.auth != null;

      // Crear: solo el propio usuario puede crear su doc (con validaciones de rango básicas)
      // SECURITY R51: el CREATE debe impedir auto-promoción a isAdmin/isReviewer/isTest/
      //   verified/premium en la PRIMERA escritura (antes el bloqueo solo existía en update).
      //   isAdmin lo consume generateMissingThumbnails. Se usa value-check (permite el
      //   campo ausente o =false, bloquea =true) para no romper payloads de signup legítimos.
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        (!request.resource.data.keys().hasAny(['latitude']) ||
         (request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90)) &&
        (!request.resource.data.keys().hasAny(['longitude']) ||
         (request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180)) &&
        (!request.resource.data.keys().hasAny(['maxDistance']) ||
         (request.resource.data.maxDistance >= 1 && request.resource.data.maxDistance <= 500)) &&
        (!request.resource.data.keys().hasAny(['isAdmin']) || request.resource.data.isAdmin == false) &&
        (!request.resource.data.keys().hasAny(['isReviewer']) || request.resource.data.isReviewer == false) &&
        (!request.resource.data.keys().hasAny(['isTest']) || request.resource.data.isTest == false) &&
        (!request.resource.data.keys().hasAny(['verified']) || request.resource.data.verified == false) &&
        (!request.resource.data.keys().hasAny(['premium']) || request.resource.data.premium == false) &&
        // R17 (2026-06-01): server-side 18+ floor at signup. birthDate was otherwise FULLY
        // client-trusted — no server age check existed, a legal gap for an 18+ sugar-dating app.
        // When present it MUST be a timestamp at least ~18 years before now. Threshold = 18*365 days
        // (567648000000 ms): deliberately conservative so it NEVER rejects a legitimate 18-year-old
        // (who is ~6574 days old; 18*365=6570) — it only blocks clear minors + future-dated births.
        // Absent birthDate is allowed at create (the user may fill it in onboarding step 2); discovery
        // now EXCLUDES unverifiable-age profiles until a valid 18+ birthDate is set. The fully-robust
        // fix is product/legal ID verification — this is the deploy-only server floor.
        // LAUNCH-SAFETY: a NON-timestamp birthDate is also allowed (never break a signup if a client
        // variant encodes birthDate differently) — discovery still excludes its unverifiable age, so
        // a string-birthDate minor cannot enter the dating pool. Only a timestamp birthDate under
        // ~18yr (or future) is rejected at signup.
        (!request.resource.data.keys().hasAny(['birthDate'])
          || !(request.resource.data.birthDate is timestamp)
          || request.time.toMillis() - request.resource.data.birthDate.toMillis() >= 567648000000);

      // UPDATE: solo el propio usuario y SOLO campos no privilegiados.
      // SECURITY: previamente un usuario podía auto-promoverse escribiendo
      //   isReviewer=true, isAdmin=true, userType='SUGAR_DADDY', verified=true,
      //   premium=true, coachMessagesRemaining=9999, accountStatus='active', etc.
      // Todos esos campos ahora están BLOQUEADOS — solo el admin SDK (CF) los escribe.
      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        // Rango de latitud/longitud/maxDistance si se escriben
        (!request.resource.data.keys().hasAny(['latitude']) ||
         (request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90)) &&
        (!request.resource.data.keys().hasAny(['longitude']) ||
         (request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180)) &&
        (!request.resource.data.keys().hasAny(['maxDistance']) ||
         (request.resource.data.maxDistance >= 1 && request.resource.data.maxDistance <= 500)) &&
        // Bloquear escritura de campos privilegiados / de-servidor
        // R135: 'blocked' removed from the unconditional blocklist — the unblock flow
        // (both clients do a standalone `update("blocked", arrayRemove(x))`) was being
        // denied, so a user could never unblock anyone. Additions to `blocked` still go
        // through the blockUser CF (Admin SDK, bypasses rules); a direct client write to
        // `blocked` is permitted ONLY when it is removal-only (see condition below).
        // 'blockedBy' stays fully CF-only (a user must never edit who blocked them).
        // R135b: 'userType' removed from the blocklist — it is a SELF-SELECTED role
        // (the CREATE rule does NOT gate it; users freely pick SUGAR_DADDY/MOMMY/BABY at
        // signup), so editing it via the profile screen is legitimate and must not fail
        // the whole edit-profile update. It is constrained to the valid enum below.
        // 'userTypeAtSignup' STAYS blocked — immutable audit trail of the original role.
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isReviewer', 'isAdmin', 'isTest', 'userTypeAtSignup',
          'verified', 'premium', 'accountStatus',
          'coachMessagesRemaining', 'coachMessagesLastReset',
          // F3/F1: server-only free-reply pool + proactive-nudge cooldown — parity with
          // coachMessagesRemaining (CF/admin-SDK only; no client writes them). Blocking the
          // free pool prevents a client inflating it to get extra free coach replies.
          'coachFreeRepliesRemaining', 'discoveryNudgeLastSentAt',
          // R15 (2026-06-01): superLikesRemaining / dailyLikesRemaining / lastLikeResetDate
          // were REMOVED from this unconditional blocklist — they DENIED the core like action
          // (see the like-counter clause added after this blocklist for the full rationale).
          // superLikesLastReset STAYS blocklisted: no client writes it (the super-reset uses
          // lastSuperLikeResetDate, which was never blocklisted).
          'superLikesLastReset',
          'safetyScore', 'safetyScoreLastUpdate',
          'simulationsRemaining', 'multiverseRemaining',
          'reportCount', 'reportsAgainstCount',
          // R151: 'receivedLikeCount' is the server-only social-proof counter the
          // discovery popularity signal scores on. It MUST be unwritable by clients —
          // otherwise a user inflates their own popularity (+8 in everyone's ranking).
          // The old signal scored candidate.liked.length (OUTGOING likes, freely
          // client-writable) which was both the wrong field and self-spoofable.
          'receivedLikeCount',
          'createdAt', 'moderationHistory', 'lastActive',
          'stripeCustomerId', 'stripeSubscriptionId',
          // R24.1: referral fields are CF-managed (redeemReferralCode grants credits + sets
          // referredBy via Admin SDK). No client writes them (verified iOS+Android signup payload).
          // Blocking keeps attribution/grant integrity (a client can't self-set referredBy/code).
          'referralCode', 'referredBy', 'referralRedeemedAt',
          'blockedBy'
        ]) &&
        // R135: a direct client `blocked` write is allowed ONLY if removal-only
        // (new ⊆ old) — i.e. unblock. Adding entries must go through blockUser CF.
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['blocked'])
          || request.resource.data.blocked.hasOnly(resource.data.get('blocked', []))) &&
        // R135b: a userType change is allowed but only to a valid role enum (parity with
        // signup, which is also ungated value-wise). first-message privilege follows the
        // chosen role — consistent with a user signing up directly as SUGAR_DADDY/MOMMY.
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userType'])
          || request.resource.data.userType in ['SUGAR_DADDY', 'SUGAR_MOMMY', 'SUGAR_BABY']) &&
        // R15 (2026-06-01): the like / super-like COUNTERS were over-blocked above and DENIED the
        // entire atomic like-batch — the core like action was BROKEN for ALL users. Both clients
        // batch the `liked`/`superLiked` arrayUnion + the counter decrement into ONE write to
        // users/{uid}; blocklisting the counter rejected the whole batch. Evidence: every user
        // stuck at dailyLikesRemaining:100, zero real likes since 2026-04-10. This is the
        // 2026-04-25 incident class (a too-strict rule silently breaking a real flow).
        // SAFE to allow: these are CLIENT-UX counters, NOT a server-trusted boundary — NO Cloud
        // Function reads them to gate anything (likes are 100% direct client writes; the
        // authoritative match lever is the reciprocal `liked` array, already owner-writable and
        // gated by the matches-create reciprocity rule; hourlyUserResets cron is the backstop).
        // Editing one's OWN counter only changes one's own client gate — already bypassable by
        // writing `liked` directly — so there is no cross-user / billing effect. Constrained to
        // non-negative numbers (anti-garbage): the daily/super RESET (set to cap) and the per-like
        // decrement (FieldValue.increment(-1), client-guarded to remaining>0) both satisfy >= 0.
        // lastLikeResetDate (a reset timestamp) is allowed unconstrained.
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dailyLikesRemaining'])
          || (request.resource.data.dailyLikesRemaining is number && request.resource.data.dailyLikesRemaining >= 0)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['superLikesRemaining'])
          || (request.resource.data.superLikesRemaining is number && request.resource.data.superLikesRemaining >= 0)) &&
        // R17 (2026-06-01): server-side 18+ floor on update (parity with create). A present
        // birthDate that IS a timestamp must be ≥~18yr (18*365 days; conservative — never rejects a
        // real 18-year-old). EXEMPTIONS so no legitimate edit is ever blocked (2026-04-25 lesson):
        // reviewer/test docs (App Review must never break), absent birthDate (bio-only edits don't
        // resend it), and a legacy NON-timestamp birthDate (older docs — discovery excludes their
        // unverifiable age anyway). Only a NEW/edited timestamp birthDate under ~18 (or future) is denied.
        (resource.data.get('isReviewer', false) == true
          || resource.data.get('isTest', false) == true
          || !request.resource.data.keys().hasAny(['birthDate'])
          || !(request.resource.data.birthDate is timestamp)
          || request.time.toMillis() - request.resource.data.birthDate.toMillis() >= 567648000000);

      // Subcolección LIKED — READ solo propietario (previene enumeración del grafo de likes)
      match /liked/{likedUserId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcolección PASSED: solo propietario
      match /passed/{passedUserId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcolección SWIPES: solo propietario
      match /swipes/{swipedUserId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcolección SUPERLIKED — READ solo propietario (previene enumeración del grafo de superLikes)
      match /superLiked/{superLikedUserId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcolección COMPATIBILITY_SCORES: solo propietario puede leer
      match /compatibility_scores/{scoreId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Subcolección COACH CHAT: historial de simulaciones + mensajes coach.
      // Tanto cliente (iOS/Android) como CF (admin SDK) pueden escribir aquí.
      //
      // Schema validation 2026-04-25 (audit Round-N): cap size + estructura.
      // Note 2026-04-25 (rules hotfix): clientes iOS/Android persisten respuestas
      // del CF localmente con sender='coach' (≥10 sitios en cada platform), p.ej.:
      //   - Coach reply tras dateCoachChat
      //   - Multi-universe result tras simulateMultiUniverse
      //   - Situation approaches tras simulateSituation
      //   - Date debrief, scorecard, error messages
      // Bloquear sender='coach' rompió esos flujos. Trade-off: el "prompt
      // injection" theoretical es self-targeting (el usuario solo manipula
      // SU propio contexto del coach — no afecta otros usuarios) y ya tiene
      // límites server-side: dateCoachChat usa rate limit + lee historia con
      // length cap (300 chars per msg en context window) + Gemini safety.
      // Mantenemos el size cap (8KB) y bloqueamos updates al sender/message.
      match /coachChat/{messageId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Create: caller debe ser dueño + tamaño limitado + sender entre allowed.
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.sender in ['user', 'coach', 'system']
          && (
            // sender='user' → senderId opcional pero debe coincidir con caller
            request.resource.data.sender != 'user'
            || (request.resource.data.senderId == null || request.resource.data.senderId == userId)
          )
          && (
            // message field: o no existe (sim payloads) o es string ≤ 8KB
            !('message' in request.resource.data)
            || (request.resource.data.message is string && request.resource.data.message.size() <= 8000)
          )
          && (
            // sessionId (2026-06-21): agrupa mensajes por sesión de chat. Opcional, string corto.
            !('sessionId' in request.resource.data)
            || (request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 64)
          );
        // Update: solo el propio user puede tocar campos no-críticos (ej. read flag).
        // Bloquea la mutación de sender/message/timestamp para evitar tampering.
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.sender == resource.data.sender
          && (
            !('message' in resource.data)
            || request.resource.data.message == resource.data.message
          )
          && (
            !('timestamp' in resource.data)
            || request.resource.data.timestamp == resource.data.timestamp
          );
        // Delete: cliente puede borrar su propio mensaje (deleteCoachMessage CF
        // usa admin SDK y bypassa esto, pero swipe-to-delete UI puede borrar local).
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Subcolección COACH SESSIONS (2026-06-21): índice de sesiones de chat del coach
      // (estilo ChatGPT, multi-dispositivo). Cada doc = una conversación; los mensajes
      // viven en coachChat con su sessionId. Solo el dueño lee/escribe/borra.
      match /coachSessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Rate-limit tracking (enforceAiRateLimit en shared.js) — solo admin SDK
      match /aiRateLimits/{fnName} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // CF runTransaction
      }

      // AI preferences learning: solo propietario lee, solo CF escribe
      match /aiPreferences/{prefId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // --- PENDING NOTIFICATIONS ---
    // SECURITY: validar senderId == caller y whitelist de keys. Previamente
    // un atacante podía crear payloads arbitrarios y el scheduled processor
    // los entregaba como push trusted.
    match /pendingNotifications/{notificationId} {
      // R15 (2026-06-01): the allowlist + anti-spoof were STALE — written for an OLD schema
      // (top-level senderId/title/body) but BOTH clients AND the consumer CF migrated to
      //   {token, notification:{title|*_loc_key, body|*_loc_key}, data:{type,senderId,...},
      //    processed, createdAt}   (R149/R152/R154 evolved handlePendingNotification to this).
      // The old hasOnly([...]) rejected `token`/`notification` and the top-level senderId check
      // failed (senderId now lives inside `data`), so EVERY client write was DENIED. chat_message
      // and new_match pushes are sent independently by the onMessageCreated/onMatchCreated triggers
      // (Admin SDK), so their denial was masked — BUT story-share pushes have NO trigger; they
      // depend solely on this client write → handlePendingNotification, so they were silently never
      // delivered. This is the 2026-04-25 incident class (a too-strict/stale rule breaking a flow).
      // New rule mirrors the REAL schema. Anti-spoof: where `data.senderId` is present it MUST be
      // the caller — every writer sets data.senderId = its own uid (chat + story); the new_match
      // writer omits it (defaults to caller → allowed, then the CF dedup-deletes it). `token` is
      // the RECIPIENT's FCM token (a caller legitimately pushes to a match), so it cannot be
      // constrained to the caller. The consumer CF validates the token + truncates title/body.
      // FLAGGED (separate, pre-existing): fcmToken is world-readable via the users read rule, so a
      // determined caller could target a known token with custom title/body — bounded, attributable
      // (data.senderId), CF-truncated; fixing it means projecting fcmToken out of discovery reads.
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly([
          'token', 'notification', 'data', 'processed', 'createdAt'
        ]) &&
        (!('data' in request.resource.data)
          || (request.resource.data.data is map
              && request.resource.data.data.get('senderId', request.auth.uid) == request.auth.uid));

      // Solo CF admin SDK lee/actualiza/elimina
      allow read, update, delete: if false;
    }

    // --- DISCOVERY STATE (cursor pagination) — CF-only write ---
    match /discoveryState/{userId} {
      allow read, write: if false;
    }

    // --- USER INTERACTIONS (Analytics) ---
    match /user_interactions/{interactionId} {
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      allow read: if false;
      allow update, delete: if false;
    }

    // --- USER ANALYTICS (Aggregated) ---
    match /user_analytics/{userId} {
      allow read, write: if false;
    }

    // --- STORIES ---
    match /stories/{storyId} {
      // Lectura abierta: la lógica de filtrado (expiresAt, isPersonal, match membership)
      // se maneja en el cliente. Match stories no exponen datos sensibles — solo la URL
      // de Storage que ya está protegida por match-membership en storage.rules.
      allow read: if request.auth != null;

      // Crear story — validar schema + senderId == caller + cap de expiresAt a 24h
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.senderId &&
        (!request.resource.data.keys().hasAny(['expiresAt']) ||
         request.resource.data.expiresAt is timestamp);

      // Update: el propietario edita el doc completo; otros solo pueden AÑADIRSE a viewedBy.
      // SECURITY: previamente un atacante podía sobrescribir viewedBy entero con IDs
      // arbitrarios. Ahora el diff de viewedBy solo puede contener al propio uid.
      allow update: if request.auth != null &&
        (
          request.auth.uid == resource.data.senderId ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy']) &&
           request.resource.data.viewedBy.hasAll(resource.data.get('viewedBy', [])))
        );

      // Eliminar: solo el creador
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.senderId;
    }

    // --- INTEREST ITEMS (catálogo público) ---
    match /interestItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /interestCategories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // --- COACH CHATS (AI Date Coach — legacy path) ---
    match /coachChats/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // --- SYSTEM STATS (for Cloud Functions) ---
    match /system_stats/{docId} {
      allow read, write: if false;
    }

    // --- REPORTS (solo CF admin SDK lee/escribe) ---
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // --- TESTER SIGNUPS (public write for beta enrollment from web) ---
    // Whitelist de campos + validación básica de schema.
    // TODO: añadir App Check enforcement en producción.
    match /testerSignups/{signupId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'platform', 'status']) &&
        // R18 (2026-06-01): + 'language' — the web beta-signup form (Public app.ts:565) writes
        // `language: currentLanguage()`, which was NOT in this allowlist → hasOnly() rejected EVERY
        // legit web signup (a silent broken flow, 2026-04-25 class). The onTesterSignup CF doesn't
        // read locale/language, so widening the allowlist is safe. (locale/source kept for compat.)
        // NOTE (FLAGGED, not fixed here): this create is UNAUTHENTICATED public + has NO App Check,
        // and onTesterSignup auto-enrolls the supplied email into the Workspace group + App
        // Distribution — abusable. App Check enforcement is a user/console decision.
        request.resource.data.keys().hasOnly(['email', 'platform', 'status', 'createdAt', 'locale', 'source', 'language']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 5 &&
        request.resource.data.email.size() < 100 &&
        request.resource.data.status == 'pending';

      allow read, update, delete: if false;
    }

    // --- COACH KNOWLEDGE (RAG corpus for Coach IA + multi-universe + intent classification) ---
    // Read-only via Admin SDK (Cloud Functions bypass rules).
    // Audit C 2026-04-25: previously implicitly locked by wildcard catch-all
    // below, but explicit rule documents that this collection is CF-only and
    // must NEVER accept client writes (would allow prompt-injection chunks
    // into RAG findNearest results that LLM agents consume as few-shot).
    match /coachKnowledge/{chunkId} {
      allow read, write: if false;
    }

    // --- INTENT LEARNING QUEUE (auto-learning from probe regressions) ---
    // CF-only. Probe writes high-priority candidates here when isAdviceRequest
    // misses but LLM Layer 5 corrects. Consolidator reviews + promotes verified
    // chunks to coachKnowledge. NEVER allow client writes.
    match /intentLearningQueue/{itemId} {
      allow read, write: if false;
    }

    // --- DEFAULT ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
